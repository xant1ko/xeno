# Учётные данные root-пользователя MongoDB для локальной разработки.
MONGO_INITDB_ROOT_USERNAME=xeno
MONGO_INITDB_ROOT_PASSWORD=change-me
# Имя базы данных приложения.
MONGO_DATABASE=xeno
# Внешние порты development-стека.
MONGO_PORT=27017
API_PORT=8000
WEB_PORT=3000
# Правила пароля при регистрации.
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
# Секрет для локальных JWT. В production используйте длинное случайное значение.
JWT_SECRET=local-development-secret-change-me
JWT_EXPIRES_IN=1d
