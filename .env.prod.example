# Учётные данные root-пользователя MongoDB. Замените значения перед production-запуском.
MONGO_INITDB_ROOT_USERNAME=xeno
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-mongodb-password
# Имя базы данных приложения.
MONGO_DATABASE=xeno
# Внешний порт Nginx с веб-приложением.
WEB_PORT=80
# Правила пароля при регистрации.
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
# Обязательный секрет подписи JWT. Используйте длинное случайное значение.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=1d
# В production с HTTPS браузер никогда не отправит JWT по незашифрованному соединению.
JWT_COOKIE_SECURE=true
# Держим browser-cookie и JWT одинаково долго: 24 часа соответствуют JWT_EXPIRES_IN=1d.
JWT_COOKIE_MAX_AGE_MS=86400000
