# Порт, на котором запускается HTTP-сервер.
PORT=8000
# URI MongoDB без логина и пароля.
MONGO_URI=mongodb://localhost:27017
# Имя базы данных приложения.
MONGO_DATABASE=xeno
# Логин администратора из dev-tools/.env.
MONGO_USERNAME=xeno
# Пароль администратора из dev-tools/.env.
MONGO_PASSWORD=change-me
# База авторизации root-пользователя MongoDB.
MONGO_AUTH_SOURCE=admin
# Минимальная длина пароля при регистрации.
PASSWORD_MIN_LENGTH=8
# Максимальная длина пароля при регистрации.
PASSWORD_MAX_LENGTH=128
# Секрет подписи JWT. Для production используйте длинное случайное значение.
JWT_SECRET=replace-with-a-long-random-secret
# Срок жизни access token в формате библиотеки jsonwebtoken.
JWT_EXPIRES_IN=1d
